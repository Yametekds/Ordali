@implements IDisposable
@inject InstallState State

@if (State.SheetOpen && State.Offer)
{
    <div class="install-backdrop" @onclick="DismissAsync"></div>
    <section class="install-sheet" role="dialog" aria-modal="true" aria-labelledby="install-title">
        <button class="install-close" type="button" aria-label="Cerrar" @onclick="DismissAsync"><Icon Name="close" /></button>
        <img class="install-logo" src="icon-192.png" alt="" width="72" height="72" />
        <h2 id="install-title">Instala Ordali en tu móvil</h2>
        <p>Ábrela desde la pantalla de inicio, a pantalla completa y sin barra del navegador. Funciona aunque se caiga la cobertura en el almacén.</p>

        @if (State.Info.CanPrompt)
        {
            <button class="btn btn-primary btn-block btn-lg" type="button" @onclick="InstallAsync">
                <Icon Name="download" /><span>Instalar la app</span>
            </button>
        }
        else if (State.Info.Ios)
        {
            <ol class="install-steps">
                <li>Pulsa <strong>Compartir</strong> <Icon Name="share" Class="inline-icon" /> en la barra de Safari.</li>
                <li>Elige <strong>Añadir a pantalla de inicio</strong>.</li>
                <li>Pulsa <strong>Añadir</strong>. Ordali aparecerá junto a tus apps.</li>
            </ol>
        }
        else
        {
            <ol class="install-steps">
                <li>Abre el menú del navegador <strong>⋮</strong>.</li>
                <li>Elige <strong>Instalar aplicación</strong> o <strong>Añadir a pantalla de inicio</strong>.</li>
            </ol>
        }

        <button class="btn btn-ghost btn-block" type="button" @onclick="DismissAsync">Ahora no</button>
    </section>
}

@code {
    protected override void OnInitialized() => State.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await State.StartAsync();
        }
    }

    public void Dispose() => State.Changed -= OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private Task DismissAsync() => State.DismissAsync();

    private Task InstallAsync() => State.PromptAsync();
}
