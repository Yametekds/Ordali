{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": false
  },
  "Jwt": {
    "Issuer": "ordali-api",
    "Audience": "ordali-clients",
    "ExpiresMinutes": 480
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedDemoData": true
  }
}
