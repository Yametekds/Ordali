<div class="progress-row">
    <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="@Total" aria-valuenow="@Done" aria-label="@L["Ubicado"]">
        <span style="width: @Percent.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></span>
    </div>
    <span class="small muted">@L["{0} de {1} ubicado", Labels.Quantity(Done), Labels.Quantity(Total)]</span>
</div>

@code {
    [Parameter] public decimal Done { get; set; }

    [Parameter] public decimal Total { get; set; }

    private decimal Percent => Total <= 0 ? 0 : Math.Clamp(Done / Total * 100, 0, 100);
}
