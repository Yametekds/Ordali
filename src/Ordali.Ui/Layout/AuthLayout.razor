@inherits LayoutComponentBase

<div class="auth">
    <aside class="auth-side">
        <div class="auth-hero">
            <BrandLogo Size="72" ShowName="false" />
            <span class="auth-name">Ordali</span>
            <span class="auth-tagline">Entradas, ubicaciones y stock de tu almacén, al día desde el móvil o el ordenador.</span>
        </div>
        <ul class="auth-facts">
            <li><strong>Escanea</strong> la entrada, el artículo y la ubicación con la cámara o una pistola.</li>
            <li><strong>Cada perfil</strong> ve solo lo que sus permisos le dejan.</li>
            <li><strong>Se instala</strong> como app en el móvil y en el ordenador.</li>
        </ul>
    </aside>
    <div class="auth-column">
        @Body
        @if (HostLinks is not null)
        {
            <nav class="auth-links" aria-label="Opciones">@HostLinks</nav>
        }
    </div>
</div>

@code {
    [CascadingParameter(Name = "HostLinks")] private RenderFragment? HostLinks { get; set; }
}
