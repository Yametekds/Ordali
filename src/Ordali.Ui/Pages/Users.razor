@page "/registros/usuarios"
@attribute [Authorize(Policy = Permissions.UsersView)]
@inject IOrdaliApi Api

<PageTitle>Usuarios · Ordali</PageTitle>

<PageHeader Title="Usuarios" Subtitle="Perfiles del personal, agrupados por categoría">
    <Actions>
        <AuthorizeView Policy="@Permissions.UsersCreate">
            <a class="btn btn-primary" href="registros/usuarios/nuevo"><Icon Name="plus" /><span>Nuevo perfil</span></a>
        </AuthorizeView>
    </Actions>
</PageHeader>

<div class="tabs" role="tablist" aria-label="Categoría">
    <a class="tab @(Category is null ? "active" : "")" href="registros/usuarios">Todos <span class="tab-count">@(users?.Count ?? 0)</span></a>
    @foreach (var category in Categories)
    {
        <a class="tab @(Category == category ? "active" : "")" href="registros/usuarios?categoria=@category">
            @Labels.Plural(category) <span class="tab-count">@(users?.Count(u => u.Category == category) ?? 0)</span>
        </a>
    }
</div>

<ErrorAlert Error="error" />

@if (users is null)
{
    @if (error is null)
    {
        <Loading />
    }
}
else
{
    @foreach (var group in Categories.Where(c => Category is null || Category == c))
    {
        var members = users.Where(u => u.Category == group).ToList();
        <section class="group">
            <h2 class="group-title">@Labels.Plural(group) <span class="muted">(@members.Count)</span></h2>
            @if (members.Count == 0)
            {
                <EmptyState IconName="users" Text="No hay perfiles en esta categoría." />
            }
            else
            {
                <div class="card card-flush">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Email</th>
                                <th>Plantilla</th>
                                <th class="num">Permisos</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in members)
                            {
                                <tr class="@(user.Active ? "" : "row-inactive")">
                                    <td data-label="Nombre"><strong>@user.Name</strong></td>
                                    <td data-label="Email">@user.Email</td>
                                    <td data-label="Plantilla">@(user.TemplateName ?? "—")</td>
                                    <td data-label="Permisos" class="num">
                                        @(user.Category == UserCategory.Admin ? "Todos" : user.Permissions.Count.ToString(Labels.Culture))
                                    </td>
                                    <td data-label="Estado">
                                        <span class="badge @(user.Active ? "badge-receipt" : "")">@(user.Active ? "Activo" : "Desactivado")</span>
                                    </td>
                                    <td class="row-actions">
                                        <AuthorizeView Policy="@Policies.Admin">
                                            <a class="btn btn-ghost btn-icon" href="registros/usuarios/@user.Id" title="Editar permisos" aria-label="Editar @user.Name">
                                                <Icon Name="edit" />
                                            </a>
                                        </AuthorizeView>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
}

@code {
    private static readonly UserCategory[] Categories = [UserCategory.Admin, UserCategory.Supervisor, UserCategory.Operator];

    [SupplyParameterFromQuery(Name = "categoria")] public string? CategoryName { get; set; }

    private IReadOnlyList<UserProfile>? users;
    private Exception? error;

    private UserCategory? Category => Enum.TryParse<UserCategory>(CategoryName, ignoreCase: true, out var c) ? c : null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            users = await Api.GetUsersAsync();
        }
        catch (ApiException ex)
        {
            error = ex;
        }
    }
}
