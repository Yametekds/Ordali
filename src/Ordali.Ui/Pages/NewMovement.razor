@page "/movimientos/nuevo"
@attribute [Authorize(Policy = Permissions.MovementsCreate)]
@inject IOrdaliApi Api
@inject SessionState Session

<PageTitle>Registrar movimiento · Ordali</PageTitle>

<PageHeader Title="Registrar movimiento" />

@if (products is null)
{
    <ErrorAlert Error="error" />
    @if (error is null)
    {
        <Loading />
    }
}
else
{
    <div class="alert alert-info">
        <Icon Name="info" />
        <span>Las entradas se registran en <a href="entradas/nueva">Nueva entrada</a> y se ubican desde <a href="traslados">Traslados</a>.</span>
    </div>
    <div class="card form-card">
        <ScanField Id="movement-product" Label="Escanear artículo" Placeholder="EAN o SKU" AutoFocus="true" OnScan="OnProductScannedAsync"
                   Hint="Con un lector de códigos de barras, escanea y el artículo se elige solo." />
        <EditForm EditContext="editContext" OnSubmit="SubmitAsync" FormName="movement">
            <div class="segmented" role="radiogroup" aria-label="Tipo de movimiento">
                @foreach (var type in AllowedTypes)
                {
                    <button type="button" role="radio" aria-checked="@(model.Type == type ? "true" : "false")"
                            class="@(model.Type == type ? "active" : "")" @onclick="() => SetType(type)">
                        @Labels.Of(type)
                    </button>
                }
            </div>
            <p class="muted small">@Help(model.Type)</p>

            <div class="form-grid">
                <label class="field field-wide">
                    <span>Artículo</span>
                    <InputSelect TValue="Guid?" Value="model.ProductId" ValueExpression="() => model.ProductId" ValueChanged="OnProductChangedAsync">
                        <option value="">Elige un artículo</option>
                        @foreach (var product in products)
                        {
                            <option value="@product.Id">@product.Sku · @product.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => model.ProductId" />
                </label>

                @if (MovementRules.NeedsFrom(model.Type))
                {
                    <label class="field">
                        <span>Origen</span>
                        <InputSelect @bind-Value="model.FromLocationId">
                            <option value="">Elige el origen</option>
                            @foreach (var location in OriginLocations)
                            {
                                <option value="@location.Id">@location.Code (@Labels.Quantity(Available(location.Id, null)))</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => model.FromLocationId" />
                    </label>
                }

                @if (MovementRules.NeedsTo(model.Type))
                {
                    <label class="field">
                        <span>@(model.Type == MovementType.Adjustment ? "Ubicación" : "Destino")</span>
                        <InputSelect @bind-Value="model.ToLocationId">
                            <option value="">Elige la ubicación</option>
                            @foreach (var location in locations)
                            {
                                <option value="@location.Id">@location.Code · @Labels.Of(location.Type)</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => model.ToLocationId" />
                    </label>
                }

                @if (SelectedProduct?.TracksLots == true)
                {
                    <label class="field">
                        <span>Lote</span>
                        <InputText @bind-Value="model.Lot" list="lots" autocomplete="off" />
                        <datalist id="lots">
                            @foreach (var lot in productStock.Where(s => s.Lot is not null).Select(s => s.Lot).Distinct())
                            {
                                <option value="@lot"></option>
                            }
                        </datalist>
                        <ValidationMessage For="() => model.Lot" />
                    </label>
                }

                <label class="field">
                    <span>Cantidad @(SelectedProduct is null ? "" : $"({SelectedProduct.Unit})")</span>
                    <InputNumber @bind-Value="model.Quantity" step="any" inputmode="decimal" />
                    @if (model.Type == MovementType.Adjustment)
                    {
                        <small class="muted">Positiva para sumar, negativa para restar.</small>
                    }
                    else if (model.FromLocationId is { } from)
                    {
                        <small class="muted">Disponible en origen: @Labels.Quantity(Available(from, model.Lot))</small>
                    }
                    <ValidationMessage For="() => model.Quantity" />
                </label>

                <label class="field field-wide">
                    <span>Motivo @(model.Type == MovementType.Adjustment ? "" : "(opcional)")</span>
                    <InputText @bind-Value="model.Reason" placeholder="Pedido, albarán, recuento…" />
                    <ValidationMessage For="() => model.Reason" />
                </label>
            </div>

            <ErrorAlert Error="error" />
            @if (saved is not null)
            {
                <div class="alert alert-ok" role="status">
                    Registrado: @Labels.Of(saved.Type) de @Labels.Quantity(saved.Quantity) de @saved.Sku.
                    <a href="movimientos">Ver movimientos</a>
                </div>
            }

            <div class="form-actions">
                <a class="btn" href="movimientos">Cancelar</a>
                <button class="btn btn-primary" type="submit" disabled="@busy">@(busy ? "Registrando…" : "Registrar")</button>
            </div>
        </EditForm>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "tipo")] public string? InitialType { get; set; }

    private readonly MovementInput model = new();
    private EditContext editContext = default!;
    private ValidationMessageStore messages = default!;
    private IReadOnlyList<Product>? products;
    private IReadOnlyList<Location> locations = [];
    private IReadOnlyList<StockItem> productStock = [];
    private Movement? saved;
    private Exception? error;
    private bool busy;

    private IEnumerable<MovementType> AllowedTypes =>
        Enum.GetValues<MovementType>()
            .Where(t => t != MovementType.Receipt)
            .Where(t => t != MovementType.Adjustment || Session.Current?.User.Can(Permissions.MovementsAdjust) == true);

    private Product? SelectedProduct => products?.FirstOrDefault(p => p.Id == model.ProductId);

    // Only locations that hold the selected item are offered as an origin.
    private IEnumerable<Location> OriginLocations =>
        locations.Where(l => productStock.Any(s => s.LocationId == l.Id && s.Quantity > 0));

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(model);
        messages = new ValidationMessageStore(editContext);
        editContext.OnFieldChanged += (_, e) => messages.Clear(e.FieldIdentifier);

        if (Enum.TryParse<MovementType>(InitialType, ignoreCase: true, out var type) && AllowedTypes.Contains(type))
        {
            model.Type = type;
        }

        try
        {
            products = await Api.GetProductsAsync();
            locations = await Api.GetLocationsAsync();
        }
        catch (ApiException ex)
        {
            error = ex;
        }
    }

    private void SetType(MovementType type)
    {
        model.Type = type;
        model.FromLocationId = MovementRules.NeedsFrom(type) ? model.FromLocationId : null;
        model.ToLocationId = MovementRules.NeedsTo(type) ? model.ToLocationId : null;
        messages.Clear();
        editContext.NotifyValidationStateChanged();
    }

    private async Task OnProductChangedAsync(Guid? productId)
    {
        model.ProductId = productId;
        model.FromLocationId = null;
        model.Lot = null;
        editContext.NotifyFieldChanged(editContext.Field(nameof(MovementInput.ProductId)));
        productStock = productId is { } id ? await Api.GetStockAsync(productId: id) : [];
    }

    private async Task OnProductScannedAsync(ScanEventArgs scan)
    {
        var product = products?.FirstOrDefault(p => Scanning.IsProduct(scan.Code, p.Sku, p.Gtin));
        if (product is null)
        {
            error = new ApiException(HttpStatusCode.NotFound, $"No hay ningún artículo con el código {scan.Code}.");
            scan.Reject();
            return;
        }

        error = null;
        await OnProductChangedAsync(product.Id);
    }

    private decimal Available(Guid locationId, string? lot) =>
        productStock
            .Where(s => s.LocationId == locationId && (string.IsNullOrWhiteSpace(lot) || s.Lot == lot.Trim()))
            .Sum(s => s.Quantity);

    private async Task SubmitAsync()
    {
        messages.Clear();
        error = null;
        saved = null;

        var errors = MovementRules.Validate(model);
        if (errors.Count > 0)
        {
            Show(errors);
            return;
        }

        busy = true;
        try
        {
            saved = await Api.CreateMovementAsync(model);
            productStock = await Api.GetStockAsync(productId: model.ProductId);
            model.Quantity = 1;
            model.Reason = null;
        }
        catch (ApiException ex)
        {
            if (ex.Errors.Count > 0)
            {
                Show(ex.Errors);
            }
            else
            {
                error = ex;
            }
        }
        finally
        {
            busy = false;
        }
    }

    private void Show(IReadOnlyDictionary<string, string[]> errors)
    {
        foreach (var (field, text) in errors)
        {
            messages.Add(editContext.Field(char.ToUpperInvariant(field[0]) + field[1..]), text);
        }

        editContext.NotifyValidationStateChanged();
    }

    private static string Help(MovementType type) => type switch
    {
        MovementType.Shipment => "Mercancía que sale del almacén hacia un cliente.",
        MovementType.Transfer => "Cambio de ubicación dentro del almacén, por ejemplo para reponer picking.",
        MovementType.Adjustment => "Corrección tras un recuento o por rotura. Siempre con motivo.",
        _ => "",
    };
}
