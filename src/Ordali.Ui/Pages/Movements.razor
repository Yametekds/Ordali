@page "/movimientos"
@attribute [Authorize(Policy = Permissions.MovementsView)]
@inject IOrdaliApi Api

<PageTitle>@L["Movimientos"] · Ordali</PageTitle>

<PageHeader Title="@L["Movimientos"]" Subtitle="@L["Cada movimiento guarda quién lo hizo y cuándo. No se pueden editar ni borrar."]">
    <Actions>
        <AuthorizeView Policy="@Permissions.MovementsCreate">
            <a class="btn btn-primary" href="movimientos/nuevo"><Icon Name="plus" /><span>@L["Registrar movimiento"]</span></a>
        </AuthorizeView>
    </Actions>
</PageHeader>

<ErrorAlert Error="error" />

@if (movements is null)
{
    @if (error is null)
    {
        <Loading />
    }
}
else if (movements.Count == 0)
{
    <EmptyState IconName="swap" Text="@L["Todavía no hay movimientos."]" />
}
else
{
    <div class="card card-flush">
        <table class="table">
            <thead>
                <tr>
                    <th>@L["Fecha"]</th>
                    <th>@L["Tipo"]</th>
                    <th>SKU</th>
                    <th>@L["Lote"]</th>
                    <th>@L["Origen → destino"]</th>
                    <th class="num">@L["Cantidad"]</th>
                    <th>@L["Usuario"]</th>
                    <th>@L["Entrada"]</th>
                    <th>@L["Motivo"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in movements)
                {
                    <tr>
                        <td data-label="@L["Fecha"]">@Labels.DateTime(m.CreatedAt)</td>
                        <td data-label="@L["Tipo"]"><MovementTypeBadge Type="m.Type" /></td>
                        <td data-label="SKU"><strong class="mono">@m.Sku</strong></td>
                        <td data-label="@L["Lote"]" class="mono">@(m.Lot ?? "—")</td>
                        <td data-label="@L["Ruta"]" class="mono">@(m.FromLocationCode ?? "—") → @(m.ToLocationCode ?? "—")</td>
                        <td data-label="@L["Cantidad"]" class="num">@(m.Type == MovementType.Adjustment ? Labels.SignedQuantity(m.Quantity) : Labels.Quantity(m.Quantity))</td>
                        <td data-label="@L["Usuario"]">@m.UserName</td>
                        <td data-label="@L["Entrada"]" class="mono">@m.Reference</td>
                        <td data-label="@L["Motivo"]" class="muted">@m.Reason</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<Movement>? movements;
    private Exception? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            movements = await Api.GetMovementsAsync(take: 200);
        }
        catch (ApiException ex)
        {
            error = ex;
        }
    }
}
