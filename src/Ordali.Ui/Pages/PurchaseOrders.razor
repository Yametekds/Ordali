@page "/pedidos"
@attribute [Authorize(Policy = Permissions.OrdersView)]
@inject IOrdaliApi Api
@inject SessionState Session

<PageTitle>@L["Pedidos"] · Ordali</PageTitle>

<PageHeader Title="@L["Pedidos a distribuidores"]" Subtitle="@L["Lo que baja del rango seguro se propone solo; después se ajusta y se añade lo que haga falta."]">
    <Actions>
        @if (CanEdit)
        {
            <a class="btn" href="distribuidores"><Icon Name="truck" /><span>@L["Distribuidores"]</span></a>
            <a class="btn btn-primary" href="pedidos/nuevo"><Icon Name="plus" /><span>@L["Nuevo pedido"]</span></a>
        }
    </Actions>
</PageHeader>

@if (CanEdit && suggestions is not null)
{
    <section class="group">
        <h2 class="group-title">@L["Por pedir"]</h2>
        @if (suggestions.Count == 0)
        {
            <p class="muted">@L["Todo el stock está dentro de su rango seguro."]</p>
        }
        else
        {
            <div class="reorder-grid">
                @foreach (var suggestion in suggestions)
                {
                    var draft = suggestion.SupplierId is { } supplierId ? Draft(supplierId) : null;
                    <article class="reorder-card">
                        <h3>@(suggestion.SupplierName ?? L["Sin distribuidor asignado"])</h3>
                        <span class="muted small">
                            @(suggestion.Lines.Count == 1 ? L["1 artículo por debajo del mínimo"] : L["{0} artículos por debajo del mínimo", suggestion.Lines.Count])
                        </span>
                        <ul>
                            @foreach (var line in suggestion.Lines.Take(4))
                            {
                                <li><strong>@line.Sku</strong> · @L["quedan {0}, pedir {1} {2}", Labels.Quantity(line.Available), Labels.Quantity(line.SuggestedQuantity), Labels.Unit(line.Unit)]</li>
                            }
                            @if (suggestion.Lines.Count > 4)
                            {
                                <li class="muted">@L["y {0} más", suggestion.Lines.Count - 4]</li>
                            }
                        </ul>
                        @if (suggestion.SupplierId is null)
                        {
                            <span class="muted small">@L["Asigna un distribuidor en la ficha de cada artículo para pedirlos."]</span>
                        }
                        else if (draft is not null)
                        {
                            <a class="btn btn-sm" href="pedidos/@draft.Id">@L["Seguir con el borrador {0}", draft.Code]</a>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-primary" href="pedidos/nuevo?distribuidor=@suggestion.SupplierId">@L["Preparar pedido"]</a>
                        }
                    </article>
                }
            </div>
        }
    </section>
}

<nav class="tabs" aria-label="@L["Estado"]">
    <button type="button" class="tab @(openOnly ? "active" : "")" @onclick="() => openOnly = true">@L["Abiertos"]</button>
    <button type="button" class="tab @(openOnly ? "" : "active")" @onclick="() => openOnly = false">@L["Todos"]</button>
</nav>

<ErrorAlert Error="error" />

@if (orders is null)
{
    @if (error is null)
    {
        <Loading />
    }
}
else if (Visible.Count == 0)
{
    <EmptyState IconName="cart" Text="@(openOnly ? L["No hay pedidos en curso."] : L["Todavía no hay pedidos."])" />
}
else
{
    <div class="card card-flush">
        <table class="table">
            <thead>
                <tr>
                    <th>@L["Pedido"]</th>
                    <th>@L["Distribuidor"]</th>
                    <th class="num">@L["Líneas"]</th>
                    <th>@L["Entrega"]</th>
                    <th>@L["Estado"]</th>
                    <th>@L["Preparado"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Visible)
                {
                    <tr>
                        <td data-label="@L["Pedido"]" class="mono"><strong>@order.Code</strong></td>
                        <td data-label="@L["Distribuidor"]">@order.SupplierName</td>
                        <td data-label="@L["Líneas"]" class="num">@order.Lines.Count</td>
                        <td data-label="@L["Entrega"]">@(order.DeliveryDate is { } date ? Labels.Date(date) : "—")</td>
                        <td data-label="@L["Estado"]"><span class="badge @Labels.BadgeClass(order.Status)">@Labels.Of(order.Status)</span></td>
                        <td data-label="@L["Preparado"]">@order.UserName · @Labels.DateTime(order.CreatedAt)</td>
                        <td class="row-actions">
                            <a class="btn btn-sm" href="pedidos/@order.Id">@(order.Status == PurchaseOrderStatus.Draft && CanEdit ? L["Editar"] : L["Ver"])</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<PurchaseOrder>? orders;
    private IReadOnlyList<ReorderSuggestion>? suggestions;
    private bool openOnly = true;
    private Exception? error;

    private bool CanEdit => Session.Current?.User.Can(Permissions.OrdersEdit) == true;

    private List<PurchaseOrder> Visible => [.. orders!.Where(o => !openOnly || o.IsOpen)];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            orders = await Api.GetPurchaseOrdersAsync();
            if (CanEdit)
            {
                suggestions = await Api.GetReorderSuggestionsAsync();
            }
        }
        catch (ApiException ex)
        {
            error = ex;
        }
    }

    private PurchaseOrder? Draft(Guid supplierId) =>
        orders?.FirstOrDefault(o => o.SupplierId == supplierId && o.Status == PurchaseOrderStatus.Draft);
}
