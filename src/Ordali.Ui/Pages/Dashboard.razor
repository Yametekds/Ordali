@page "/"
@attribute [Authorize]
@inject IOrdaliApi Api
@inject TimeProvider Time
@inject SessionState Session

<PageTitle>@L["Inicio"] · Ordali</PageTitle>

<PageHeader Title="@Today">
    <Actions>
        <AuthorizeView Policy="@Permissions.MovementsCreate">
            <a class="btn" href="entradas/nueva"><Icon Name="inbox" /><span>@L["Nueva entrada"]</span></a>
            <a class="btn btn-primary" href="traslados"><Icon Name="dolly" /><span>@L["Traslados"]</span></a>
        </AuthorizeView>
    </Actions>
</PageHeader>

<ErrorAlert Error="error" />

@if (!loaded)
{
    @if (error is null)
    {
        <Loading />
    }
}
else
{
    <dl class="summary">
        @if (Can(Permissions.ProductsView))
        {
            <div><dt>@L["Productos"]</dt><dd>@products.Count.ToString(Labels.Culture)</dd></div>
        }
        @if (Can(Permissions.StockView))
        {
            <div><dt>@L["Unidades en stock"]</dt><dd>@Labels.Quantity(stock.Sum(s => s.Quantity))<small>@L["en {0} líneas", stock.Count]</small></dd></div>
        }
        @if (Can(Permissions.MovementsView))
        {
            <div><dt>@L["Movimientos hoy"]</dt><dd>@movementsToday.ToString(Labels.Culture)</dd></div>
        }
    </dl>

    <div class="home">
        @if (ShowsPending)
        {
            @* What someone has to act on goes first: receipts still at the dock and products below their minimum. *@
            <section class="card pending">
                <header class="panel-head">
                    <h2>@L["Pendiente"] @if (PendingCount > 0) { <span class="count">@PendingCount</span> }</h2>
                </header>
                @if (PendingCount == 0)
                {
                    <EmptyState IconName="check" Text="@L["Nada pendiente: todas las entradas están ubicadas y el stock está por encima del mínimo."]" />
                }
                else
                {
                    <ul class="tasks">
                        @foreach (var receipt in pendingReceipts)
                        {
                            <li>
                                <a class="task" href="@(Can(Permissions.MovementsCreate) ? $"traslados?entrada={receipt.Code}" : "entradas")">
                                    <span class="badge badge-receipt">@L["Por ubicar"]</span>
                                    <span class="task-what"><strong>@receipt.Code</strong><span>@L["en {0}", receipt.DockLocationCode]</span></span>
                                    <span class="task-meta">@L["{0} de {1} uds.", Labels.Quantity(receipt.Pending), Labels.Quantity(receipt.Quantity)]</span>
                                </a>
                            </li>
                        }
                        @foreach (var item in lowStock)
                        {
                            <li>
                                <a class="task" href="stock?articulo=@item.Product.Id">
                                    <span class="badge badge-warning">@L["Bajo mínimo"]</span>
                                    <span class="task-what"><strong>@item.Product.Sku</strong><span>@item.Product.Name</span></span>
                                    <span class="task-meta">@L["{0} de {1}", Labels.Quantity(item.Total), Labels.Quantity(item.Product.MinStock)]</span>
                                    <span class="meter" aria-hidden="true"><span style="width: @Fill(item)%"></span></span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </section>
        }

        @if (Can(Permissions.MovementsView))
        {
            <section class="card">
                <header class="panel-head">
                    <h2>@L["Últimos movimientos"]</h2>
                    @if (movements.Count > 0)
                    {
                        <a class="link" href="movimientos">@L["Ver todos"] <Icon Name="arrow-right" /></a>
                    }
                </header>
                @if (movements.Count == 0)
                {
                    <EmptyState Text="@L["Todavía no hay movimientos."]" />
                }
                else
                {
                    <ul class="activity">
                        @foreach (var movement in movements.Take(6))
                        {
                            <li>
                                <MovementTypeBadge Type="movement.Type" />
                                <span><strong>@movement.Sku</strong> @Labels.SignedQuantity(Signed(movement))</span>
                                <small>@movement.UserName · @Labels.Relative(movement.CreatedAt, now)</small>
                            </li>
                        }
                    </ul>
                }
            </section>
        }
    </div>
}

@code {
    private IReadOnlyList<Product> products = [];
    private IReadOnlyList<StockItem> stock = [];
    private IReadOnlyList<Movement> movements = [];
    private IReadOnlyList<Receipt> pendingReceipts = [];
    private List<(Product Product, decimal Total)> lowStock = [];
    private int movementsToday;
    private DateTimeOffset now;
    private bool loaded;
    private Exception? error;

    private bool Can(string permission) => Session.Current?.User.Can(permission) ?? false;

    private bool ShowsPending => Can(Permissions.MovementsView) || (Can(Permissions.ProductsView) && Can(Permissions.StockView));

    private int PendingCount => pendingReceipts.Count + lowStock.Count;

    // "Lunes, 3 de noviembre" ("Monday 3 November"): the date is what the home page is about, so it is the title.
    private string Today
    {
        get
        {
            var text = Time.GetLocalNow().ToString(L["dddd, d 'de' MMMM"], Labels.Culture);
            return char.ToUpper(text[0], Labels.Culture) + text[1..];
        }
    }

    private static string Fill((Product Product, decimal Total) item) =>
        (item.Product.MinStock <= 0 ? 0 : Math.Clamp(item.Total / item.Product.MinStock * 100, 0, 100))
            .ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Each profile only loads the figures its permissions allow.
            products = Can(Permissions.ProductsView) ? await Api.GetProductsAsync() : [];
            stock = Can(Permissions.StockView) ? await Api.GetStockAsync() : [];
            movements = Can(Permissions.MovementsView) ? await Api.GetMovementsAsync(take: 100) : [];
            pendingReceipts = Can(Permissions.MovementsView) ? await Api.GetReceiptsAsync(pendingOnly: true) : [];
        }
        catch (ApiException ex)
        {
            error = ex;
            return;
        }

        now = Time.GetUtcNow();
        var totals = stock.GroupBy(s => s.ProductId).ToDictionary(g => g.Key, g => g.Sum(s => s.Quantity));
        lowStock = [.. products
            .Select(p => (Product: p, Total: totals.GetValueOrDefault(p.Id)))
            .Where(x => x.Total < x.Product.MinStock)
            .OrderBy(x => x.Total / Math.Max(x.Product.MinStock, 1))];
        var today = now.ToLocalTime().Date;
        movementsToday = movements.Count(m => m.CreatedAt.ToLocalTime().Date == today);
        loaded = true;
    }

    // Shipments take stock out, so they read as negative next to entries.
    private static decimal Signed(Movement m) => m.Type == MovementType.Shipment ? -m.Quantity : m.Quantity;
}
