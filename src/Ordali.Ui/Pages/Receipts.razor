@page "/entradas"
@attribute [Authorize(Policy = Permissions.MovementsView)]
@inject IOrdaliApi Api
@inject SessionState Session

<PageTitle>@L["Entradas"] · Ordali</PageTitle>

<PageHeader Title="@L["Entradas"]" Subtitle="@L["Mercancía recibida en el muelle. Se ubica desde Traslados."]">
    <Actions>
        @if (CanCreate)
        {
            <a class="btn" href="traslados"><Icon Name="dolly" /><span>@L["Traslados"]</span></a>
            <a class="btn btn-primary" href="entradas/nueva"><Icon Name="plus" /><span>@L["Nueva entrada"]</span></a>
        }
    </Actions>
</PageHeader>

<nav class="tabs" aria-label="@L["Estado"]">
    <button type="button" class="tab @(pendingOnly ? "active" : "")" @onclick="() => ShowAsync(true)">@L["Por ubicar"]</button>
    <button type="button" class="tab @(pendingOnly ? "" : "active")" @onclick="() => ShowAsync(false)">@L["Todas"]</button>
</nav>

<ErrorAlert Error="error" />

@if (receipts is null)
{
    @if (error is null)
    {
        <Loading />
    }
}
else if (receipts.Count == 0)
{
    <EmptyState IconName="inbox" Text="@(pendingOnly ? L["No hay mercancía pendiente de ubicar."] : L["Todavía no hay entradas."])" />
}
else
{
    <div class="card card-flush">
        <table class="table">
            <thead>
                <tr>
                    <th>@L["Código"]</th>
                    <th>@L["Referencia"]</th>
                    <th>@L["Artículos"]</th>
                    <th class="num">@L["Ubicado"]</th>
                    <th>@L["Estado"]</th>
                    <th>@L["Recibida"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var receipt in receipts)
                {
                    <tr>
                        <td data-label="@L["Código"]" class="mono"><strong>@receipt.Code</strong></td>
                        <td data-label="@L["Referencia"]" class="muted">@receipt.Reference</td>
                        <td data-label="@L["Artículos"]">@string.Join(", ", receipt.Lines.Select(l => l.Sku))</td>
                        <td data-label="@L["Ubicado"]" class="num">
                            @Labels.Quantity(receipt.Quantity - receipt.Pending) / @Labels.Quantity(receipt.Quantity)
                        </td>
                        <td data-label="@L["Estado"]">
                            <span class="badge @(receipt.Status == ReceiptStatus.Pending ? "badge-warning" : "badge-receipt")">@Labels.Of(receipt.Status)</span>
                        </td>
                        <td data-label="@L["Recibida"]">@receipt.UserName · @Labels.DateTime(receipt.CreatedAt)</td>
                        <td class="row-actions">
                            @if (CanCreate && receipt.Status == ReceiptStatus.Pending)
                            {
                                <a class="btn btn-sm" href="traslados?entrada=@Uri.EscapeDataString(receipt.Code)">@L["Ubicar"]</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<Receipt>? receipts;
    private bool pendingOnly = true;
    private Exception? error;

    private bool CanCreate => Session.Current?.User.Can(Permissions.MovementsCreate) == true;

    protected override Task OnInitializedAsync() => ShowAsync(true);

    private async Task ShowAsync(bool pending)
    {
        pendingOnly = pending;
        error = null;
        try
        {
            receipts = await Api.GetReceiptsAsync(pendingOnly: pending);
        }
        catch (ApiException ex)
        {
            error = ex;
        }
    }
}
